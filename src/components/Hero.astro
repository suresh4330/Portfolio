---
// Hero section - Premium AI/ML Engineer Hero for Annamneedi Suresh Kumar
const base = import.meta.env.BASE_URL;
---

<section class="hero" id="hero" aria-label="Hero Introduction">
  <div class="hero-container">
    <!-- Professional Avatar Spotlight -->
    <div class="hero-profile-avatar">
      <div class="avatar-ring">
        <img src={`${base}sureshphoto.jpeg`} alt="Annamneedi Suresh Kumar — AI/ML Engineer" class="avatar-img" />
        <span class="avatar-badge" title="Verified AI/ML Engineer & OCI Certified">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
      </div>
    </div>

    <div class="hero-badge-wrapper">
      <div class="status-badge">
        <span class="status-pulse" aria-hidden="true">
          <span class="pulse-ring"></span>
          <span class="pulse-dot"></span>
        </span>
        <span class="status-text">B.Tech CSE (AI & ML) • CGPA: 8.32 • Lovely Professional University (2027)</span>
      </div>
    </div>

    <div class="hero-header">
      <p class="hero-greeting">Hi, I'm</p>
      <h1 class="hero-name">
        <span class="gradient-text-ai">Annamneedi Suresh Kumar</span>
      </h1>
      <h2 class="hero-role">
        AI/ML Engineer <span class="role-separator">•</span> Generative AI Developer <span class="role-separator">•</span> Software Engineer
      </h2>
      <p class="hero-tagline">
        Architecting Intelligent Systems, Generative AI Models, and High-Performance Software
      </p>
    </div>

    <p class="hero-bio">
      Passionate about machine learning, deep neural architectures, and scalable software systems.
      Specializing in <strong>Mixture of Experts (MoE)</strong>, <strong>Edge Model Compression</strong> (pruning, INT8 quantization), <strong>LLM/RAG pipelines</strong>, and containerized backend architectures designed for real-world impact.
    </p>

    <div class="hero-actions">
      <a href="#projects" class="btn btn-primary">
        <span>View Projects</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </a>
      <a href={`${base}cv.pdf`} download="Annamneedi_Suresh_Kumar_CV.pdf" class="btn btn-cv-hero" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download CV</span>
      </a>
      <a href="#skills" class="btn btn-secondary">
        <span>Explore Skills</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </a>
      <a href="#contact" class="btn btn-outline">
        <span>Contact Me</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </a>
    </div>

    <!-- Social Profiles & Quick Links -->
    <div class="hero-socials">
      <a href="https://github.com/suresh4330" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub Profile (suresh4330)">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>GitHub</span>
      </a>

      <a href="https://linkedin.com/in/annamneedi-suresh-kumar" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn Profile (Annamneedi Suresh Kumar)">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
        </svg>
        <span>LinkedIn</span>
      </a>

      <div class="social-divider" aria-hidden="true"></div>

      <div class="hero-skills-cloud">
        <span class="cloud-label">Key Competencies:</span>
        <span class="quick-pill pill-purple">PyTorch</span>
        <span class="quick-pill pill-cyan">Generative AI &amp; LLMs</span>
        <span class="quick-pill pill-purple">Mixture of Experts (MoE)</span>
        <span class="quick-pill pill-cyan">Edge Model Compression</span>
        <span class="quick-pill pill-blue">FastAPI</span>
        <span class="quick-pill pill-purple">FAISS &amp; ChromaDB</span>
        <span class="quick-pill pill-cyan">OpenAI CLIP</span>
        <span class="quick-pill pill-emerald">OCI Certified AI</span>
        <span class="quick-pill pill-blue">Docker &amp; Compose</span>
        <span class="quick-pill pill-emerald">PostgreSQL</span>
        <span class="quick-pill pill-blue">TypeScript &amp; React 18</span>
        <span class="quick-pill pill-purple">RAG &amp; AI Agents</span>
        <span class="quick-pill pill-cyan">Python (Modular)</span>
        <span class="quick-pill pill-blue">Prometheus &amp; Grafana</span>
        <span class="quick-pill pill-emerald">scikit-learn</span>
      </div>
    </div>
  </div>

  <!-- Decorative Lighting Orbs -->
  <div class="hero-glows" aria-hidden="true">
    <div class="glow-orb orb-primary"></div>
    <div class="glow-orb orb-purple"></div>
    <div class="glow-orb orb-cyan"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: calc(var(--nav-height) + 2.5rem) 1.5rem 4.5rem;
    overflow: hidden;
  }

  .hero-container {
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Avatar Spotlight */
  .hero-profile-avatar {
    margin-bottom: 1.5rem;
    animation: fadeInDown 0.5s ease-out;
  }

  .avatar-ring {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent-cyan), var(--color-accent-purple));
    box-shadow: 0 0 35px rgba(6, 182, 212, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .avatar-ring:hover {
    transform: scale(1.04);
    box-shadow: 0 0 45px rgba(6, 182, 212, 0.65);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    border: 3px solid #030712;
  }

  .avatar-badge {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #10B981;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2.5px solid #030712;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.6);
  }

  .hero-badge-wrapper {
    margin-bottom: 1.5rem;
    animation: fadeInDown 0.6s ease-out;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.4rem 1.125rem;
    background: rgba(17, 24, 39, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-dim);
    box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.5);
  }

  .status-pulse {
    position: relative;
    width: 9px;
    height: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #10B981;
    border-radius: 50%;
  }

  .pulse-ring {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.4);
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .hero-greeting {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-accent-cyan);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .hero-name {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    font-weight: 800;
    line-height: 1.08;
    margin-bottom: 1.125rem;
    letter-spacing: -0.03em;
  }

  .hero-role {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2.5vw, 1.45rem);
    font-weight: 600;
    color: #E2E8F0;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .role-separator {
    color: var(--color-accent-cyan);
    font-weight: 400;
    opacity: 0.6;
  }

  .hero-tagline {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-text-dim);
    font-weight: 400;
    max-width: 720px;
    margin: 0 auto 1.75rem;
    line-height: 1.5;
  }

  .hero-bio {
    font-size: clamp(0.95rem, 1.6vw, 1.08rem);
    color: var(--color-text-dim);
    max-width: 760px;
    margin: 0 auto 2.5rem;
    line-height: 1.75;
  }

  .hero-bio strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }

  .btn-cv-hero {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.15), rgba(59, 130, 246, 0.15));
    border: 1px solid var(--color-accent-cyan);
    color: #FFFFFF;
    box-shadow: 0 0 20px rgba(6, 182, 212, 0.25);
  }

  .btn-cv-hero:hover {
    background: var(--color-accent-cyan);
    color: #030712;
    box-shadow: 0 0 30px rgba(6, 182, 212, 0.5);
    transform: translateY(-2px);
  }

  .hero-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    width: 100%;
    max-width: 680px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-dim);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.4rem 0.875rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    color: #FFFFFF;
    background: rgba(59, 130, 246, 0.12);
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .social-divider {
    width: 1px;
    height: 20px;
    background: var(--color-border);
  }

  .hero-skills-cloud {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 840px;
    margin: 0 auto;
  }

  .cloud-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #CBD5E1;
    margin-right: 0.25rem;
  }

  .quick-pill {
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.32rem 0.8rem;
    border-radius: 9999px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    cursor: default;
    display: inline-flex;
    align-items: center;
  }

  .quick-pill:hover {
    transform: translateY(-2px);
  }

  .pill-purple {
    color: #DDD6FE;
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.35);
  }
  .pill-purple:hover {
    box-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
    background: rgba(139, 92, 246, 0.22);
  }

  .pill-cyan {
    color: #A5F3FC;
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid rgba(6, 182, 212, 0.35);
  }
  .pill-cyan:hover {
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    background: rgba(6, 182, 212, 0.22);
  }

  .pill-blue {
    color: #BFDBFE;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.35);
  }
  .pill-blue:hover {
    box-shadow: 0 0 15px rgba(59, 130, 246, 0.4);
    background: rgba(59, 130, 246, 0.22);
  }

  .pill-emerald {
    color: #A7F3D0;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
  }
  .pill-emerald:hover {
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.22);
  }

  /* Lighting Glows in background */
  .hero-glows {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
  }

  .orb-primary {
    width: 450px;
    height: 450px;
    background: #3B82F6;
    top: 15%;
    left: 15%;
    animation: floatOrb 10s ease-in-out infinite alternate;
  }

  .orb-purple {
    width: 400px;
    height: 400px;
    background: #8B5CF6;
    bottom: 15%;
    right: 15%;
    animation: floatOrb 12s ease-in-out infinite alternate-reverse;
  }

  .orb-cyan {
    width: 320px;
    height: 320px;
    background: #06B6D4;
    top: 45%;
    right: 28%;
    animation: floatOrb 14s ease-in-out infinite alternate;
  }

  @keyframes floatOrb {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(30px, -30px);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: calc(var(--nav-height) + 1.5rem);
      padding-bottom: 3.5rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-role {
      flex-direction: column;
      gap: 0.25rem;
    }

    .role-separator {
      display: none;
    }

    .social-divider {
      display: none;
    }
  }
</style>
