---
// Technical Journey - An authentic narrative tracing academic & engineering evolution
const milestones = [
  {
    period: '2023 – 2024',
    tag: 'Foundations',
    badgeClass: 'badge-blue',
    title: 'Computer Science & Algorithmic Foundations',
    institution: 'Lovely Professional University',
    description: 'Mastering core computer science principles including Object-Oriented Programming (C++, Java), complex Data Structures & Algorithms, discrete mathematics, and relational database systems (SQL).',
    highlights: [
      'Engineered optimized data structures and algorithmic routines in C++ and Java',
      'Implemented relational schema design and complex SQL query optimization',
      'Developed strong algorithmic problem-solving instincts'
    ]
  },
  {
    period: '2024',
    tag: 'Machine Learning',
    badgeClass: 'badge-cyan',
    title: 'Statistical Computing & Machine Learning Systems',
    institution: 'Independent & Academic Research',
    description: 'Transitioned into machine learning and exploratory data analysis. Built predictive models, evaluated loss functions, and engineered data-driven decision platforms.',
    highlights: [
      'Developed Career Guidance AI System achieving 85% validation accuracy with Random Forest',
      'Implemented Movie Recommendation System combining TF-IDF and collaborative filtering algorithms',
      'Applied rigorous scikit-learn preprocessing pipelines, cross-validation, and metrics evaluation'
    ]
  },
  {
    period: '2025',
    tag: 'Deep Learning & Edge',
    badgeClass: 'badge-purple',
    title: 'Deep Learning & Edge Model Compression',
    institution: 'Specialized Model Optimization',
    description: 'Deepened focus into deep neural networks with PyTorch. Investigated the challenge of deploying resource-heavy vision networks onto power- and memory-constrained edge hardware.',
    highlights: [
      'Benchmarked ResNet-18 on CIFAR-100 across Structured/Unstructured Pruning',
      'Implemented Post-Training INT8 Quantization and Quantization-Aware Training (QAT)',
      'Leveraged Knowledge Distillation from high-capacity teacher models to retain accuracy'
    ]
  },
  {
    period: '2025 – 2026',
    tag: 'Generative AI',
    badgeClass: 'badge-ai',
    title: 'Transformers, Mixture of Experts & AI Agents',
    institution: 'Advanced AI Architecture',
    description: 'Exploring the frontiers of Generative AI, Large Language Models, and modular neural architectures that decouple model capacity from inference compute costs.',
    highlights: [
      'Architected IntelliMoE — Mixture of Experts AI with top-k dynamic gating routing',
      'Engineered hybrid Retrieval-Augmented Generation (RAG) pipelines with vector embeddings',
      'Experimented with autonomous tool-using AI Agents and LLM evaluation benchmarks'
    ]
  },
  {
    period: '2026 – Present',
    tag: 'Systems & DevOps',
    badgeClass: 'badge-emerald',
    title: 'Full-Stack Integration, Microservices & DevOps',
    institution: 'Production Systems Readiness',
    description: 'Unifying AI model serving with robust, containerized full-stack software architectures designed for high reliability, low latency, and continuous delivery.',
    highlights: [
      'Built StockFlow — full-stack inventory lifecycle system with React, Express, and TypeScript',
      'Implemented multi-stage Docker containerization and Docker Compose orchestration',
      'Designed automated CI/CD pipelines via GitHub Actions for linting, testing, and deployments'
    ]
  }
];
---

<section class="journey-section" id="journey" aria-label="Technical and Learning Journey">
  <div class="container">
    <div class="section-header">
      <div class="badge badge-emerald">Milestones</div>
      <h2 class="section-title">Technical Journey</h2>
      <p class="section-subtitle">
        A timeline of academic progression, deep technical experimentation, and continuous development across AI/ML and software engineering.
      </p>
    </div>

    <div class="timeline">
      {milestones.map((item, index) => (
        <div class="timeline-item" data-index={index}>
          <div class="timeline-marker" aria-hidden="true">
            <div class="marker-dot"></div>
            <div class="marker-line"></div>
          </div>

          <div class="timeline-content glass-panel">
            <div class="timeline-meta">
              <span class:list={['badge', item.badgeClass]}>{item.tag}</span>
              <span class="timeline-period">{item.period}</span>
            </div>

            <h3 class="timeline-title">{item.title}</h3>
            <div class="timeline-inst">{item.institution}</div>
            <p class="timeline-desc">{item.description}</p>

            <ul class="timeline-bullets">
              {item.highlights.map((point) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .journey-section {
    padding: 6rem 0;
    position: relative;
  }

  .timeline {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 1.75rem;
    position: relative;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .marker-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #0B0F19;
    border: 3px solid var(--color-primary);
    box-shadow: 0 0 12px var(--color-primary-glow);
    z-index: 2;
    flex-shrink: 0;
    margin-top: 1.5rem;
  }

  .timeline-item:hover .marker-dot {
    border-color: var(--color-accent-cyan);
    box-shadow: 0 0 16px var(--color-accent-cyan-glow);
  }

  .marker-line {
    width: 2px;
    height: 100%;
    background: linear-gradient(180deg, rgba(59, 130, 246, 0.4), rgba(139, 92, 246, 0.2));
    margin-top: -0.25rem;
  }

  .timeline-item:last-child .marker-line {
    display: none;
  }

  .timeline-content {
    padding: 1.85rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
  }

  .timeline-content:hover {
    transform: translateX(4px);
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .timeline-period {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-dim);
    font-family: var(--font-heading);
  }

  .timeline-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.25rem;
    line-height: 1.35;
  }

  .timeline-inst {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-accent-cyan);
    margin-bottom: 0.85rem;
  }

  .timeline-desc {
    color: var(--color-text-dim);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-bottom: 1.125rem;
  }

  .timeline-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .timeline-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #CBD5E1;
    line-height: 1.45;
  }

  .timeline-bullets svg {
    color: #10B981;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 24px 1fr;
      gap: 1rem;
    }

    .marker-dot {
      width: 14px;
      height: 14px;
      margin-top: 1.25rem;
    }
  }
</style>

