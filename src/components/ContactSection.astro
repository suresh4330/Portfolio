---
// Contact Section - Clean, accessible contact channels and interactive form with client-side validation
---

<section class="contact-section" id="contact" aria-label="Contact Annamneedi Suresh Kumar">
  <div class="container">
    <div class="section-header">
      <div class="badge badge-cyan">Connect</div>
      <h2 class="section-title">Get in Touch</h2>
      <p class="section-subtitle">
        Interested in discussing AI/ML engineering roles, internship opportunities, research collaborations, or software projects? Let's connect.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Contact Information Cards -->
      <div class="contact-info-col">
          <div class="info-card glass-panel">
          <div class="info-icon icon-email">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="info-body">
            <div class="info-label">Direct Email</div>
            <a href="mailto:annamneedisuresh003@gmail.com" class="info-value">
              annamneedisuresh003@gmail.com
            </a>
            <p class="info-subtext">Best channel for opportunities & professional correspondence.</p>
          </div>
        </div>

        <div class="info-card glass-panel">
          <div class="info-icon icon-phone">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="info-body">
            <div class="info-label">Direct Mobile</div>
            <a href="tel:+919121104330" class="info-value">
              +91-9121104330
            </a>
            <p class="info-subtext">Direct calling and instant communications.</p>
          </div>
        </div>

        <div class="info-card glass-panel">
          <div class="info-icon icon-linkedin">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
            </svg>
          </div>
          <div class="info-body">
            <div class="info-label">LinkedIn Profile</div>
            <a href="https://linkedin.com/in/annamneedi-suresh-kumar" target="_blank" rel="noopener noreferrer" class="info-value">
              linkedin.com/in/annamneedi-suresh-kumar
            </a>
            <p class="info-subtext">Professional network, academic milestones, and connections.</p>
          </div>
        </div>

        <div class="info-card glass-panel">
          <div class="info-icon icon-github">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
          </div>
          <div class="info-body">
            <div class="info-label">GitHub Repositories</div>
            <a href="https://github.com/suresh4330" target="_blank" rel="noopener noreferrer" class="info-value">
              github.com/suresh4330
            </a>
            <p class="info-subtext">Open-source code, model experiments, and system implementations.</p>
          </div>
        </div>

        <div class="closing-statement glass-panel">
          <h4>Availability & Closing Note</h4>
          <p>
            I am actively seeking <strong>AI/ML Engineering, Generative AI, and Software Engineering internships and full-time roles</strong> for the 2027 graduating cycle. I bring disciplined technical rigor, a passion for deep learning architectures, and a commitment to building reliable, production-ready software.
          </p>
        </div>
      </div>

      <!-- Interactive Contact Form -->
      <div class="contact-form-col">
        <form class="contact-form glass-panel" id="contact-form" novalidate>
          <h3 class="form-title">Send a Direct Message</h3>
          <p class="form-desc">Fill out the details below and I will respond to your inquiry promptly.</p>

          <div class="form-group">
            <label for="contact-name">Your Full Name <span class="required">*</span></label>
            <input
              type="text"
              id="contact-name"
              name="name"
              placeholder="e.g. Alex Morgan"
              required
              aria-required="true"
            />
            <span class="field-error" id="name-error">Please enter your name.</span>
          </div>

          <div class="form-group">
            <label for="contact-email">Email Address <span class="required">*</span></label>
            <input
              type="email"
              id="contact-email"
              name="email"
              placeholder="e.g. alex@company.com"
              required
              aria-required="true"
            />
            <span class="field-error" id="email-error">Please enter a valid email address.</span>
          </div>

          <div class="form-group">
            <label for="contact-subject">Subject <span class="required">*</span></label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              placeholder="e.g. AI/ML Engineering Role / Project Discussion"
              required
              aria-required="true"
            />
            <span class="field-error" id="subject-error">Please enter a subject.</span>
          </div>

          <div class="form-group">
            <label for="contact-message">Message <span class="required">*</span></label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              placeholder="Describe your project, team opportunity, or discussion topic..."
              required
              aria-required="true"
            ></textarea>
            <span class="field-error" id="message-error">Please enter a message (at least 10 characters).</span>
          </div>

          <button type="submit" class="btn btn-primary btn-submit" id="submit-btn">
            <span class="submit-text">Send Message</span>
            <svg class="submit-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>

          <!-- Status Alert Message -->
          <div class="form-alert" id="form-alert" role="alert" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 6rem 0 8rem;
    position: relative;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 2.25rem;
    align-items: start;
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-card {
    padding: 1.5rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .info-icon {
    width: 48px;
    height: 48px;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-email {
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: var(--color-primary);
  }

  .icon-linkedin {
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid rgba(6, 182, 212, 0.3);
    color: var(--color-accent-cyan);
  }

  .icon-github {
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.3);
    color: var(--color-accent-purple);
  }

  .icon-phone {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #6EE7B7;
  }

  .icon-cv {
    background: rgba(236, 72, 153, 0.12);
    border: 1px solid rgba(236, 72, 153, 0.3);
    color: #F472B6;
  }

  .info-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .info-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .info-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: #FFFFFF;
    text-decoration: none;
    word-break: break-all;
    transition: color 0.2s ease;
  }

  .info-value:hover {
    color: var(--color-accent-cyan);
  }

  .placeholder-tag {
    font-size: 0.75rem;
    color: var(--color-accent-pink);
    font-weight: 500;
  }

  .info-subtext {
    font-size: 0.82rem;
    color: var(--color-text-dim);
    margin: 0.25rem 0 0;
  }

  .closing-statement {
    padding: 1.5rem;
    background: rgba(15, 23, 42, 0.7);
    border-left: 3px solid var(--color-accent-cyan);
  }

  .closing-statement h4 {
    font-size: 1rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.5rem;
  }

  .closing-statement p {
    font-size: 0.88rem;
    color: var(--color-text-dim);
    line-height: 1.65;
    margin: 0;
  }

  .closing-statement strong {
    color: #FFFFFF;
  }

  /* Contact Form */
  .contact-form {
    padding: 2.25rem;
  }

  .form-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.35rem;
  }

  .form-desc {
    font-size: 0.9rem;
    color: var(--color-text-dim);
    margin-bottom: 1.75rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .required {
    color: var(--color-accent-pink);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(3, 7, 18, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    color: #FFFFFF;
    font-family: var(--font-body);
    font-size: 0.92rem;
    transition: all 0.2s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 15px var(--color-primary-glow);
    background: rgba(3, 7, 18, 0.9);
  }

  .form-group input.invalid,
  .form-group textarea.invalid {
    border-color: #EF4444;
  }

  .field-error {
    font-size: 0.78rem;
    color: #F87171;
    display: none;
  }

  .field-error.visible {
    display: block;
  }

  .btn-submit {
    width: 100%;
    padding: 0.875rem 1.5rem;
    margin-top: 0.5rem;
    font-size: 1rem;
  }

  .form-alert {
    display: none;
    margin-top: 1.25rem;
    padding: 0.85rem 1.15rem;
    border-radius: 0.5rem;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .form-alert.success {
    display: block;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #6EE7B7;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const setupContactForm = () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('form-alert');
    if (!form || !alertBox) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('contact-name') as HTMLInputElement;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement;
      const subjectInput = document.getElementById('contact-subject') as HTMLInputElement;
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;

      let isValid = true;

      // Validate name
      if (!nameInput.value.trim()) {
        nameInput.classList.add('invalid');
        document.getElementById('name-error')?.classList.add('visible');
        isValid = false;
      } else {
        nameInput.classList.remove('invalid');
        document.getElementById('name-error')?.classList.remove('visible');
      }

      // Validate email
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailInput.value.trim() || !emailRegex.test(emailInput.value)) {
        emailInput.classList.add('invalid');
        document.getElementById('email-error')?.classList.add('visible');
        isValid = false;
      } else {
        emailInput.classList.remove('invalid');
        document.getElementById('email-error')?.classList.remove('visible');
      }

      // Validate subject
      if (!subjectInput.value.trim()) {
        subjectInput.classList.add('invalid');
        document.getElementById('subject-error')?.classList.add('visible');
        isValid = false;
      } else {
        subjectInput.classList.remove('invalid');
        document.getElementById('subject-error')?.classList.remove('visible');
      }

      // Validate message
      if (!messageInput.value.trim() || messageInput.value.trim().length < 10) {
        messageInput.classList.add('invalid');
        document.getElementById('message-error')?.classList.add('visible');
        isValid = false;
      } else {
        messageInput.classList.remove('invalid');
        document.getElementById('message-error')?.classList.remove('visible');
      }

      if (isValid) {
        alertBox.className = 'form-alert success';
        alertBox.textContent = `Thank you, ${nameInput.value.trim()}! Your message has been prepared. You can also reach out directly to annamneedisuresh003@gmail.com.`;
        form.reset();
      }
    });
  };

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>

