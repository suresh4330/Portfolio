---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[] | undefined;
}

const base = import.meta.env.BASE_URL;
const { title, description, pubDate, slug, tags } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="blog-card">
  <a href={`${base}blog/${slug}/`} class="blog-card-link glass-panel">
    <div class="blog-card-content">
      <time class="blog-date">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        {formattedDate}
      </time>
      <h3 class="blog-title">{title}</h3>
      <p class="blog-description">{description}</p>
      {tags && tags.length > 0 && (
        <div class="blog-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      <span class="read-more">
        <span>Read Technical Article</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .blog-card {
    position: relative;
    height: 100%;
  }

  .blog-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.85rem;
    text-decoration: none;
    color: var(--color-text);
    border-radius: 1.15rem;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .blog-card-link:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
  }

  .blog-card-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .blog-date {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--color-accent-cyan);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .blog-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.65rem;
    color: #FFFFFF;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .blog-card-link:hover .blog-title {
    color: var(--color-accent-cyan);
  }

  .blog-description {
    color: var(--color-text-dim);
    line-height: 1.6;
    font-size: 0.88rem;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }

  .tag {
    padding: 0.2rem 0.55rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.35rem;
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .read-more svg {
    transition: transform 0.2s ease;
  }

  .blog-card-link:hover .read-more svg {
    transform: translateX(4px);
  }
</style>
