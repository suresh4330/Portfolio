---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const base = import.meta.env.BASE_URL;
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Available filter categories
const categories = ['All', 'AI / Deep Learning', 'Machine Learning', 'Full Stack & DevOps', 'Full Stack & Web'];
---

<section class="projects-section" id="projects" aria-label="Featured AI and Machine Learning Projects">
  <div class="container">
    <div class="section-header">
      <div class="badge badge-ai">Selected Works</div>
      <h2 class="section-title">Featured Projects</h2>
      <p class="section-subtitle">
        Production-grade Mixture-of-Experts architectures, edge deep learning compression benchmarks, machine learning systems, and full-stack applications.
      </p>

      <!-- Category Filter Pills -->
      <div class="filter-bar" role="tablist" aria-label="Project Categories">
        {categories.map((cat, idx) => (
          <button
            class:list={['filter-btn', { active: idx === 0 }]}
            data-filter={cat}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid" id="projects-grid">
      {sortedProjects.map((project) => (
        <div class="project-item" data-category={project.data.category}>
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            problem={project.data.problem}
            features={project.data.features}
            metrics={project.data.metrics}
            category={project.data.category}
            tags={project.data.tags}
            github={project.data.github}
            link={project.data.link}
            featured={project.data.featured}
            image={project.data.image}
          />
        </div>
      ))}
    </div>

    <div class="projects-footer">
      <a href={`${base}projects/`} class="btn btn-secondary">
        <span>Explore Detailed Project Case Studies</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: 6rem 0;
    position: relative;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .filter-btn {
    padding: 0.5rem 1.15rem;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: var(--font-body);
    color: var(--color-text-dim);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .filter-btn:hover {
    color: #FFFFFF;
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.35);
  }

  .filter-btn.active {
    color: #FFFFFF;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.25), rgba(139, 92, 246, 0.25));
    border-color: var(--color-primary);
    box-shadow: 0 0 15px var(--color-primary-glow);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .project-item {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .project-item.hidden {
    display: none;
  }

  .projects-footer {
    text-align: center;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const initProjectFilters = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.project-item');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const selectedCategory = btn.getAttribute('data-filter');

        items.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (selectedCategory === 'All' || itemCat === selectedCategory) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });
  };

  initProjectFilters();
  document.addEventListener('astro:page-load', initProjectFilters);
</script>

