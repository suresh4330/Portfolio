---
// Technical Skills Showcase - Structured strictly to Annamneedi Suresh Kumar's verified competencies
const categories = [
  {
    id: 'programming',
    title: 'Programming Languages',
    badge: 'Core',
    color: 'blue',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`,
    description: 'Foundational syntax and algorithmic problem-solving across systems, data, and web stacks.',
    skills: [
      { name: 'Python', highlight: true, note: 'AI/ML & Backend' },
      { name: 'Java', highlight: false, note: 'OOP & Core Systems' },
      { name: 'C', highlight: false, note: 'Systems Foundations' },
      { name: 'C++', highlight: true, note: 'Algorithms & Performance' },
      { name: 'JavaScript', highlight: false, note: 'ES6+ Full-Stack' },
      { name: 'TypeScript', highlight: true, note: 'Type-Safe Applications' },
      { name: 'SQL (PostgreSQL)', highlight: true, note: 'Relational Schemas & Queries' },
    ]
  },
  {
    id: 'aiml',
    title: 'AI, Generative AI & Vector Search',
    badge: 'Specialization',
    color: 'purple',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 1 4 4c0 1.5-.8 2.8-2 3.5V11a2 2 0 0 1-2 2h0a2 2 0 0 1-2-2V9.5C8.8 8.8 8 7.5 8 6a4 4 0 0 1 4-4z"></path><path d="M12 13v9"></path><path d="M7 17l5-4 5 4"></path></svg>`,
    description: 'Neural architectures, statistical inference, language models, sparse routing, and high-dimensional vector retrieval.',
    skills: [
      { name: 'PyTorch', highlight: true, note: 'Core Deep Learning' },
      { name: 'Generative AI & LLMs', highlight: true, note: 'Gemini, OpenAI, Groq' },
      { name: 'Mixture of Experts (MoE)', highlight: true, note: 'Sparse Gating Routing' },
      { name: 'Transformers', highlight: true, note: 'Attention & Fine-Tuning' },
      { name: 'RAG Retrieval', highlight: true, note: 'Context Augmentation' },
      { name: 'ChromaDB', highlight: true, note: 'Vector Storage' },
      { name: 'FAISS Vector Search', highlight: true, note: 'IndexFlatIP Sub-15ms' },
      { name: 'CLIP Embeddings', highlight: false, note: 'Vision-Language (ViT-B/32)' },
      { name: 'Model Evaluation', highlight: false, note: 'Latency, Accuracy & XAI' },
    ]
  },
  {
    id: 'frameworks',
    title: 'Frameworks & Data Analytics',
    badge: 'Engineering',
    color: 'cyan',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>`,
    description: 'Data science, compute graphs, asynchronous microservices, and interactive component user interfaces.',
    skills: [
      { name: 'FastAPI', highlight: true, note: 'High-Throughput Async APIs' },
      { name: 'scikit-learn', highlight: true, note: 'Supervised/Unsupervised ML' },
      { name: 'Pandas & NumPy', highlight: true, note: 'Feature Engineering & EDA' },
      { name: 'Flask', highlight: false, note: 'Lightweight REST Services' },
      { name: 'React 18', highlight: true, note: 'Interactive Component UIs' },
      { name: 'Node.js & Express', highlight: false, note: 'Full-Stack Services' },
      { name: 'RESTful APIs', highlight: false, note: 'Clean API Contracts' },
      { name: 'Statistical Analysis', highlight: false, note: 'Hypothesis & Distributions' },
    ]
  },
  {
    id: 'tools',
    title: 'Tools & Platforms',
    badge: 'Workflow',
    color: 'blue',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`,
    description: 'Developer environments, version tracking, container runtimes, and agentic IDE tooling.',
    skills: [
      { name: 'Git', highlight: true, note: 'Distributed Version Control' },
      { name: 'GitHub', highlight: true, note: 'Collaboration & Repos' },
      { name: 'Docker', highlight: true, note: 'Containerization' },
      { name: 'Linux', highlight: true, note: 'CLI & Shell Scripting' },
      { name: 'VS Code', highlight: false, note: 'Primary Editor' },
      { name: 'Antigravity', highlight: true, note: 'Agentic AI Development' },
    ]
  },
  {
    id: 'devops',
    title: 'DevOps & Cloud',
    badge: 'Infrastructure',
    color: 'emerald',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>`,
    description: 'Continuous delivery, infrastructure automation, container orchestration, and cloud fundamentals.',
    skills: [
      { name: 'Docker & Compose', highlight: true, note: 'Multi-Stage & Orchestration' },
      { name: 'OCI Cloud Platforms', highlight: true, note: 'Oracle Certified AI Foundations' },
      { name: 'CI/CD Pipelines', highlight: true, note: 'Automated GitHub Actions' },
      { name: 'Prometheus & Grafana', highlight: true, note: 'Real-Time Observability' },
      { name: 'Nginx', highlight: false, note: 'Reverse Proxy & Static Serving' },
      { name: 'Terraform', highlight: false, note: 'Infrastructure as Code' },
      { name: 'Linux', highlight: true, note: 'Bash & Server Operations' },
    ]
  }
];
---

<section class="skills-section" id="skills" aria-label="Technical Skills & Competencies">
  <div class="container">
    <div class="section-header">
      <div class="badge badge-purple">Core Competencies</div>
      <h2 class="section-title">Technical Skills</h2>
      <p class="section-subtitle">
        A rigorous toolkit spanning machine learning architectures, high-performance backends, and containerized DevOps infrastructure.
      </p>
    </div>

    <div class="skills-grid">
      {categories.map((cat) => (
        <div class="skill-category glass-panel" data-category={cat.id}>
          <div class="category-top">
            <div class:list={['category-icon-box', `icon-${cat.color}`]} set:html={cat.icon} />
            <div class="category-meta">
              <span class:list={['badge', `badge-${cat.color}`]}>{cat.badge}</span>
              <h3 class="category-title">{cat.title}</h3>
            </div>
          </div>

          <p class="category-desc">{cat.description}</p>

          <div class="skill-tags">
            {cat.skills.map((skill) => (
              <div class:list={['skill-pill', { highlighted: skill.highlight }]}>
                <span class="skill-name">{skill.name}</span>
                {skill.highlight && <span class="skill-dot" aria-hidden="true"></span>}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding: 6rem 0;
    position: relative;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.75rem;
  }

  .skill-category {
    padding: 1.85rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .skill-category:hover {
    transform: translateY(-3px);
  }

  .category-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .category-icon-box {
    width: 46px;
    height: 46px;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-purple {
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.3);
    color: #C084FC;
  }

  .icon-blue {
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #93C5FD;
  }

  .icon-cyan {
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid rgba(6, 182, 212, 0.3);
    color: #67E8F9;
  }

  .icon-emerald {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #6EE7B7;
  }

  .category-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .category-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .category-desc {
    color: var(--color-text-dim);
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.375rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-dim);
    transition: all 0.2s ease;
    cursor: default;
  }

  .skill-pill:hover {
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.4);
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .skill-pill.highlighted {
    background: rgba(59, 130, 246, 0.08);
    border-color: rgba(59, 130, 246, 0.25);
    color: #E2E8F0;
    font-weight: 500;
  }

  .skill-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-cyan);
    display: inline-block;
  }

  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
