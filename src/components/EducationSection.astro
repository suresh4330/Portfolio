---
// Education section - Focused presentation of academic foundation from CV

const educationList = [
  {
    institution: 'Lovely Professional University',
    location: 'Punjab, India',
    degree: 'Bachelor of Technology (B.Tech), Computer Science and Engineering',
    specialization: 'Artificial Intelligence & Machine Learning',
    score: 'CGPA: 8.32',
    scoreType: 'cgpa',
    period: 'Aug 2023 – Jul 2027',
    status: 'Currently Enrolled (Final Year)',
    statusBadge: 'badge-emerald',
    description: 'In-depth specialization in neural networks, sparse Mixture of Experts, edge model compression, distributed computing, and full-stack software development.',
    coursework: [
      'Data Structures & Algorithms',
      'Machine Learning & Deep Learning',
      'Generative AI & LLMs',
      'Operating Systems',
      'Database Management Systems (PostgreSQL/SQL)',
      'Computer Networks',
      'Software Engineering & Cloud Computing'
    ]
  },
  {
    institution: 'Sri Shiridi Sai Jr College',
    location: 'Rajahmundry, Andhra Pradesh',
    degree: 'Intermediate (MPC — Mathematics, Physics, Chemistry)',
    specialization: 'State Board of Intermediate Education',
    score: 'Score: 87.8%',
    scoreType: 'percentage',
    period: 'Jun 2021 – Apr 2023',
    status: 'Completed',
    statusBadge: 'badge-blue',
    description: 'Advanced mathematics, calculus, physics, and analytical problem-solving forming the mathematical backbone for machine learning algorithms.',
    coursework: [
      'Advanced Mathematics & Calculus',
      'Linear Algebra Foundations',
      'Physics & Analytical Mechanics',
      'Chemistry'
    ]
  },
  {
    institution: 'Vignan School',
    location: 'Malikipuram, Andhra Pradesh',
    degree: 'Secondary School Certificate (SSC)',
    specialization: 'Foundational Sciences & Mathematics',
    score: 'Score: 81%',
    scoreType: 'percentage',
    period: 'Jun 2019 – Apr 2021',
    status: 'Completed',
    statusBadge: 'badge-purple',
    description: 'Excellence in mathematics, scientific fundamentals, and early computational problem-solving.',
    coursework: [
      'Mathematics & Geometry',
      'Physical Sciences',
      'Information Technology Fundamentals'
    ]
  }
];
---

<section class="education-section" id="education" aria-label="Education and Academic Background">
  <div class="container">
    <div class="section-header">
      <div class="badge badge-blue">Academic Foundation</div>
      <h2 class="section-title">Education & Academic Journey</h2>
      <p class="section-subtitle">
        Rigorous computer science curriculum grounding theoretical principles in practical software implementation.
      </p>
    </div>

    <!-- Education Timeline Cards -->
    <div class="edu-cards-container">
      {educationList.map((edu, idx) => (
        <div class:list={['edu-card', 'glass-panel', { 'primary-edu': idx === 0 }]}>
          <div class="edu-card-header">
            <div class="edu-title-group">
              <span class:list={['badge', edu.statusBadge]}>{edu.status}</span>
              <h3 class="edu-institution">{edu.institution}</h3>
              <span class="edu-location">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {edu.location}
              </span>
            </div>

            <div class="edu-score-box">
              <span class="score-badge">{edu.score}</span>
              <span class="edu-period">{edu.period}</span>
            </div>
          </div>

          <h4 class="edu-degree">{edu.degree}</h4>
          {edu.specialization && (
            <div class="edu-spec">
              <strong>Focus:</strong> {edu.specialization}
            </div>
          )}

          <p class="edu-desc">{edu.description}</p>

          <div class="coursework-section">
            <span class="coursework-label">Key Coursework & Domains:</span>
            <div class="coursework-tags">
              {edu.coursework.map((course) => (
                <span class="c-tag">{course}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Quick Credentials Summary -->
    <div class="edu-summary-bar glass-panel">
      <div class="summary-item">
        <span class="summary-val">8.32</span>
        <span class="summary-lbl">B.Tech CGPA (LPU)</span>
      </div>
      <div class="summary-divider"></div>
      <div class="summary-item">
        <span class="summary-val">87.8%</span>
        <span class="summary-lbl">Intermediate MPC</span>
      </div>
      <div class="summary-divider"></div>
      <div class="summary-item">
        <span class="summary-val">2027</span>
        <span class="summary-lbl">Graduation Year</span>
      </div>
    </div>
  </div>
</section>

<style>
  .education-section {
    padding: 6rem 0;
    position: relative;
  }

  .edu-cards-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .edu-card {
    padding: 2.25rem;
    border-radius: 1.25rem;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .edu-card:hover {
    transform: translateY(-3px);
  }

  .primary-edu {
    border-color: rgba(59, 130, 246, 0.4);
    background: linear-gradient(135deg, rgba(11, 15, 25, 0.95), rgba(15, 23, 42, 0.7));
  }

  .edu-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .edu-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .edu-institution {
    font-size: 1.4rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0.25rem 0 0;
    font-family: var(--font-heading);
  }

  .edu-location {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--color-text-dim);
  }

  .edu-score-box {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .score-badge {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: #6EE7B7;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
  }

  .edu-period {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
  }

  .edu-degree {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-accent-cyan);
    margin-bottom: 0.4rem;
  }

  .edu-spec {
    font-size: 0.92rem;
    color: #CBD5E1;
    margin-bottom: 0.85rem;
  }

  .edu-spec strong {
    color: #FFFFFF;
  }

  .edu-desc {
    color: var(--color-text-dim);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .coursework-section {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1rem;
  }

  .coursework-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.65rem;
  }

  .coursework-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .c-tag {
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.375rem;
    color: var(--color-text-dim);
    transition: all 0.2s ease;
  }

  .c-tag:hover {
    color: #FFFFFF;
    border-color: var(--color-primary);
    background: rgba(59, 130, 246, 0.12);
  }

  /* Summary Bar */
  .edu-summary-bar {
    padding: 1.5rem 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 1.5rem;
    border-radius: 1rem;
    flex-wrap: wrap;
  }

  .summary-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .summary-val {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 800;
    color: #FFFFFF;
    background: linear-gradient(135deg, #FFFFFF, var(--color-accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .summary-lbl {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .summary-divider {
    width: 1px;
    height: 35px;
    background: rgba(255, 255, 255, 0.08);
  }

  .btn-sm {
    padding: 0.5rem 1.15rem;
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .edu-card-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .edu-score-box {
      align-items: flex-start;
    }

    .summary-divider {
      display: none;
    }

    .edu-summary-bar {
      gap: 1.25rem;
    }
  }
</style>
