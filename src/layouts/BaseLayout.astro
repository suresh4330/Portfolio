---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThreeBackground from '../components/ThreeBackground.astro';

interface Props {
  title?: string;
  description?: string;
}

const base = import.meta.env.BASE_URL;
const {
  title = 'Annamneedi Suresh Kumar | AI/ML & Software Engineer',
  description = 'Portfolio of Annamneedi Suresh Kumar — AI/ML Engineer, Generative AI Developer, and Software Engineer specializing in deep learning, LLMs, model compression, and scalable full-stack applications.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Annamneedi Suresh Kumar" />
    <meta name="keywords" content="Annamneedi Suresh Kumar, AI/ML Engineer, Generative AI Developer, Software Engineer, Machine Learning, Deep Learning, LLM, PyTorch, Model Compression, Lovely Professional University" />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts: Space Grotesk (headings) + DM Sans (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="cursor-follower" aria-hidden="true"></div>
    <ThreeBackground />
    <div id="page-content">
      <slot />
    </div>

    <style>
      #page-content {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* Custom cursor */
      .cursor-follower {
        width: 22px;
        height: 22px;
        border: 1.5px solid var(--color-accent-cyan);
        border-radius: 50%;
        position: fixed;
        pointer-events: none;
        z-index: 9999;
        transition: width 0.2s cubic-bezier(0.16, 1, 0.3, 1), height 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, border-color 0.2s ease;
        transform: translate(-50%, -50%);
        mix-blend-mode: screen;
      }

      .cursor-follower::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 4px;
        height: 4px;
        background: var(--color-accent-purple);
        border-radius: 50%;
      }

      @media (pointer: coarse), (prefers-reduced-motion: reduce) {
        .cursor-follower {
          display: none;
        }
      }
    </style>

    <script>
      const initCursor = () => {
        const cursor = document.querySelector('.cursor-follower') as HTMLElement | null;
        if (!cursor) return;

        let mouseX = -100;
        let mouseY = -100;
        let cursorX = -100;
        let cursorY = -100;

        const onMouseMove = (e: MouseEvent) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        };

        window.addEventListener('mousemove', onMouseMove, { passive: true });

        const animateCursor = () => {
          cursorX += (mouseX - cursorX) * 0.25;
          cursorY += (mouseY - cursorY) * 0.25;
          cursor.style.left = `${cursorX}px`;
          cursor.style.top = `${cursorY}px`;
          requestAnimationFrame(animateCursor);
        };
        requestAnimationFrame(animateCursor);

        const bindInteractiveElements = () => {
          const interactives = document.querySelectorAll('a, button, input, textarea, select, .project-card, .skill-category');
          interactives.forEach((el) => {
            el.addEventListener('mouseenter', () => {
              cursor.style.width = '42px';
              cursor.style.height = '42px';
              cursor.style.backgroundColor = 'rgba(6, 182, 212, 0.15)';
              cursor.style.borderColor = 'var(--color-primary)';
            });
            el.addEventListener('mouseleave', () => {
              cursor.style.width = '22px';
              cursor.style.height = '22px';
              cursor.style.backgroundColor = 'transparent';
              cursor.style.borderColor = 'var(--color-accent-cyan)';
            });
          });
        };

        bindInteractiveElements();
      };

      if (window.matchMedia('(pointer: fine)').matches) {
        initCursor();
        document.addEventListener('astro:page-load', initCursor);
      }
    </script>
  </body>
</html>
