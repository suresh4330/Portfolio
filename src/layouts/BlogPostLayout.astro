---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date | undefined;
  tags?: string[] | undefined;
}

const base = import.meta.env.BASE_URL;
const { title, description, pubDate, updatedDate, tags } = Astro.props;

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} | Annamneedi Suresh Kumar`} description={description}>
  <Navigation />

  <article class="blog-post">
    <div class="container">
      <header class="post-header">
        <a href={`${base}blog/`} class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to All Articles
        </a>
        <h1 class="post-title gradient-text-ai">{title}</h1>
        <div class="post-meta">
          <time class="post-date">{formattedPubDate}</time>
          {formattedUpdatedDate && (
            <span class="post-updated">Updated: {formattedUpdatedDate}</span>
          )}
        </div>
        {tags && tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="post-content glass-panel">
        <slot />
      </div>
    </div>
  </article>

  <Footer />
</BaseLayout>

<style>
  .blog-post {
    min-height: 100vh;
    padding: calc(var(--nav-height) + 3rem) 1.5rem 6rem;
  }

  .container {
    max-width: 860px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-accent-cyan);
    text-decoration: none;
    margin-bottom: 1.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .back-link:hover {
    transform: translateX(-4px);
    color: #FFFFFF;
  }

  .post-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .post-meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .post-date {
    color: var(--color-accent-purple);
    font-weight: 600;
  }

  .post-updated {
    color: var(--color-text-dim);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tag {
    padding: 0.25rem 0.65rem;
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 0.35rem;
    font-size: 0.75rem;
    color: #C084FC;
    font-weight: 500;
  }

  .post-content {
    padding: 3rem;
    border-radius: 1.25rem;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    color: #FFFFFF;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .post-content :global(h1) {
    font-size: 2.25rem;
  }

  .post-content :global(h2) {
    font-size: 1.75rem;
    color: #67E8F9;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.5rem;
  }

  .post-content :global(h3) {
    font-size: 1.35rem;
    color: #93C5FD;
  }

  .post-content :global(p) {
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: var(--color-text-dim);
    font-size: 1.02rem;
  }

  .post-content :global(strong) {
    color: #FFFFFF;
  }

  .post-content :global(a) {
    color: var(--color-accent-cyan);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .post-content :global(a:hover) {
    color: #FFFFFF;
  }

  .post-content :global(code) {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.2rem 0.45rem;
    border-radius: 0.35rem;
    font-family: monospace;
    font-size: 0.9em;
    color: #A5B4FC;
  }

  .post-content :global(pre) {
    background: #030712;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.75rem 0;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    color: #E2E8F0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.75rem;
    color: var(--color-text-dim);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-content :global(li) {
    line-height: 1.7;
    font-size: 1rem;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding: 0.75rem 1.25rem;
    margin: 1.75rem 0;
    background: rgba(59, 130, 246, 0.06);
    border-radius: 0 0.5rem 0.5rem 0;
    color: #CBD5E1;
  }

  @media (max-width: 768px) {
    .post-content {
      padding: 2rem 1.5rem;
    }
  }
</style>
